{:paths ["src"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.text"}
       io.github.kotoba-lang/erc20
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.erc20"}
        io.github.kotoba-lang/base-l2
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.baseL2"}}
 :aliases
 {;; `-r ".*"` is load-bearing, not decoration. warifu's suites are named
  ;; `warifu.cells.test-refund` (test- PREFIX), and cognitect-test-runner's
  ;; default discovery regex is `.*-test$` (SUFFIX). Measured 2026-08-28 before
  ;; this line existed: `kbb -M:test` ran 51 tests / 195 assertions while
  ;; `kbb -M:test` ran 3 / 7 — it found only `warifu.repository-contract-test`
  ;; and silently skipped the other 48. A JVM green meant nothing.
  :test {:extra-paths ["test"]
         ;; cheshire is a TEST-only dep: `warifu.test-lexicons` requires it and
         ;; babashka has it built in, so the bb runner never needed it declared.
         ;; The JVM runner does.
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      cheshire/cheshire {:mvn/version "5.13.0"}}
         :main-opts ["-m" "cognitect.test-runner" "-r" ".*"]
         :exec-fn cognitect.test-runner.api/test
         :exec-args {:namespace-regex ".*"}}}}
